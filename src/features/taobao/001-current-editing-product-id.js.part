// 1. 默认娃娃图片列表 (在这里替换你想给用户的默认图片URL)
const DEFAULT_DOLL_IMAGES = [
  "https://i.postimg.cc/3rCsgRTN/tkwwj2.png",
  "https://i.postimg.cc/yxB2MqFB/tkwwj.png",
