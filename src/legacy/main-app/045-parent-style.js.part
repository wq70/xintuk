          updateClock();
          setInterval(updateClock, 1000 * 30);
          applyGlobalWallpaper();
          initBatteryManager();

          applyAppIcons();
          applyAppLabels();

          initDraggableLyricsBar(); // 初始化悬浮歌词栏的拖动功能

          // ==========================================================
          // --- 各种事件监听器 ---
          // ==========================================================

          // “查角色手机”功能事件监听器

          // 1. 绑定主屏幕上的“查手机”APP图标
          document
            .getElementById("check-phone-btn")
