                  isGroup: false,
                  isPinned: false,
                  npcLibrary: [], // 角色专属NPC库
                  relationship: {
                    status: "friend",
                    blockedTimestamp: null,
                    applicationReason: "",
                  },
                  status: {
                    text: "在线",
                    lastUpdate: Date.now(),
                    isBusy: false,
                  },
                  settings: {
                    aiPersona: "你是谁呀。",
                    myPersona: "我是谁呀。",
                    maxMemory: 10,
                    aiAvatar: defaultAvatar,
                    myAvatar: defaultAvatar,
                    background: "",
                    theme: "default",
                    fontSize: 13,
                    customCss: "",
                    linkedWorldBookIds: [],
                    aiAvatarLibrary: [],
                    stickerLibrary: [], // 专属表情库
                    // === 以下是本次修复新增的初始化属性 ===
                    linkedMemories: [], // 【修复核心】初始化记忆互通数组
                    offlineMode: {
                      enabled: false,
