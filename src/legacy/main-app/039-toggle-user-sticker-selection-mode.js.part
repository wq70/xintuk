         */
        function toggleCharStickerSelectionMode() {
          isCharStickerSelectionMode = !isCharStickerSelectionMode;
          const screen = document.getElementById("char-sticker-manager-screen");

          // 清空选择集并更新UI
          selectedCharStickers.clear();
