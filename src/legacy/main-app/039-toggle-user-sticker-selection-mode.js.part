                "datingPresets",
                "datingSpriteGroups",
                "datingSprites",
                "datingHistory",
              ],
            },

            {
              id: "tukeyAccounting",
              name: "兔k记账 (账户/群聊/账单/设置)",
              tables: [
                "tukeyAccounts",
                "tukeyAccountingGroups",
                "tukeyAccountingRecords",
                "tukeyAccountingReplies",
                "tukeyUserSettings",
                "tukeyCustomConfig",
