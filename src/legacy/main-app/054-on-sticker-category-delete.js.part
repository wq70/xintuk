          // 使用事件委托处理电脑桌面所有图标的点击
          document
            .getElementById("kk-computer-desktop")
            .addEventListener("click", (e) => {
              const icon = e.target.closest(".kk-desktop-icon");
              if (!icon) return;

              const computerData =
                state.chats[activeKkCharId]?.houseData?.computer;
              if (!computerData) {
                showCustomAlert("错误", "找不到电脑数据。");
                return;
              }

              switch (icon.id) {
                case "kk-browser-icon":
                  const history = computerData.browser_history || [];
                  // 【修改】不再用 showCustomAlert，改用新写的列表展示函数
                  showComputerContentList(
                    "浏览器历史 (点击分享)",
                    history,
                    "浏览器",
                  );
                  break;

                case "kk-movies-icon":
                  const movies = computerData.movies || [];
                  // 【修改】同上
                  showComputerContentList("D盘电影 (点击分享)", movies, "D盘");
                  break;

                case "kk-files-icon":
                  // 保持原样，打开文件浏览器
                  // 注意：如果你想让文件也能分享，需要去 openFileExplorer 函数里改，
                  // 但文件目前是点击查看内容，建议保持现状或在查看器里加分享按钮
                  openFileExplorer();
                  break;

                case "kk-secret-folder-icon":
                  const secretFolder = computerData.secret_folder;
                  if (secretFolder) {
                    showCustomConfirm(
                      "加密访问",
                      `你尝试打开文件 "${secretFolder.fileName}"。<br><br>这是一个加密文件夹，是否继续访问？`,
                    ).then((confirmed) => {
                      if (confirmed) {
                        // 【修改】解密后直接弹出分享确认框，而不是只显示 Alert
                        openComputerItemShareModal(
                          secretFolder.fileName,
                          secretFolder.content,
                          "加密文件夹",
                        );
                      }
                    });
                  } else {
                    showCustomAlert("未发现", "没有找到隐秘文件夹。");
                  }
                  break;

                case "kk-steam-icon":
                  openSteamScreen();
                  break;
              }
            });

