          // 2. 转为 Base64 字符串 (天然包含大小写字母和数字)
          let base64 = CryptoJS.enc.Base64.stringify(rawHash);

          // 3. 截取前 12 位 (增加长度)
          let generated = base64.substring(0, 12);

          // 4. 强制插入特殊符号 (增强复杂度)
          // 将字符串转为数组进行替换
          let chars = generated.split("");
          chars[2] = "@"; // 第3位强制变为 @
          chars[7] = "!"; // 第8位强制变为 !

          // 重新组合
          const correctPassword = chars.join("");

          // console.log("正确密码应为:", correctPassword); // 调试用，上线可注释
          return pwd.trim() === correctPassword;
        }

        // 项目名与入口目录共同构成命名空间：同域不同项目路径、不同本地目录均不会串用数据。
        const storageProjectRoot = new URL("./", window.location.href);
        const STORAGE_PROJECT_ID = `tuk-phone:${storageProjectRoot.protocol}//${storageProjectRoot.host}${storageProjectRoot.pathname}`;
        const LEGACY_DATABASE_NAME = "GeminiChatDB";

        function getScopedStorageKey(key) {
          return `ephone:${STORAGE_PROJECT_ID}:${key}`;
        }

        const projectStorage = {
          getItem(key) {
            return localStorage.getItem(getScopedStorageKey(key));
          },
          setItem(key, value) {
            localStorage.setItem(getScopedStorageKey(key), value);
          },
          removeItem(key) {
            localStorage.removeItem(getScopedStorageKey(key));
          },
          clear() {
            const prefix = `${getScopedStorageKey("")}`;
            const scopedKeys = [];
            for (let index = 0; index < localStorage.length; index += 1) {
              const key = localStorage.key(index);
              if (key && key.startsWith(prefix)) scopedKeys.push(key);
            }
            scopedKeys.forEach((key) => localStorage.removeItem(key));
            localStorage.setItem(getScopedStorageKey("__cleared__"), "true");
          },
        };

        function getProjectDatabaseName(userId) {
          return `${LEGACY_DATABASE_NAME}::${STORAGE_PROJECT_ID}::${encodeURIComponent(String(userId))}`;
        }

        async function legacyDatabaseExists() {
          try {
            if (typeof indexedDB.databases === "function") {
              const databases = await indexedDB.databases();
              return databases.some((database) => database.name === LEGACY_DATABASE_NAME);
            }
          } catch (error) {
            console.warn("[System] 无法枚举本地数据库，将使用兼容检测：", error);
          }
          return Dexie.exists(LEGACY_DATABASE_NAME);
        }

        async function readLegacyDatabase() {
          return new Promise((resolve, reject) => {
            const request = indexedDB.open(LEGACY_DATABASE_NAME);
            request.onerror = () => reject(request.error || new Error("无法读取旧版本地数据。"));
            request.onsuccess = () => {
              const legacyDb = request.result;
              const storeNames = Array.from(legacyDb.objectStoreNames);
              if (storeNames.length === 0) {
                legacyDb.close();
                resolve({});
                return;
              }

              const transaction = legacyDb.transaction(storeNames, "readonly");
              const recordsByStore = {};
              let pendingCount = storeNames.length;
              let finished = false;
              const finish = (error) => {
                if (finished) return;
                finished = true;
                legacyDb.close();
                if (error) reject(error);
                else resolve(recordsByStore);
              };

              transaction.onerror = () => finish(transaction.error || new Error("读取旧版本地数据失败。"));
              transaction.onabort = () => finish(transaction.error || new Error("读取旧版本地数据被中止。"));

              storeNames.forEach((storeName) => {
                const getAllRequest = transaction.objectStore(storeName).getAll();
                getAllRequest.onerror = () => finish(getAllRequest.error || new Error(`读取旧数据表 ${storeName} 失败。`));
                getAllRequest.onsuccess = () => {
                  recordsByStore[storeName] = getAllRequest.result || [];
                  pendingCount -= 1;
                  if (pendingCount === 0) finish();
                };
              });
            };
          });
        }

        function normalizeLegacyRecords(storeName, records) {
          if (storeName !== "customAvatarFrames") return records;
          return records.map((record, index) =>
            record && record.id !== undefined && record.id !== null
              ? record
              : { ...record, id: `legacy-frame-${index}` },
          );
        }

        async function migrateLegacyDatabaseIfNeeded(userId) {
          const migrationKey = getScopedStorageKey(`legacy-db-migrated:${userId}`);
          if (localStorage.getItem(migrationKey) === "true") return;
          const legacyOwnerKey = getScopedStorageKey("legacy-db-owner");
          const legacyOwner = localStorage.getItem(legacyOwnerKey);
          if (legacyOwner && legacyOwner !== String(userId)) {
            localStorage.setItem(migrationKey, "true");
            return;
          }
          if (!(await legacyDatabaseExists())) {
            localStorage.setItem(migrationKey, "true");
            return;
          }

          const legacyRecords = await readLegacyDatabase();
          const targetTables = db.tables.filter((table) =>
            Object.prototype.hasOwnProperty.call(legacyRecords, table.name),
          );

          if (targetTables.length > 0) {
            await db.transaction("rw", ...targetTables, async () => {
              for (const table of targetTables) {
                const records = normalizeLegacyRecords(
                  table.name,
                  legacyRecords[table.name],
                );
                if (records.length > 0) await table.bulkPut(records);
              }
            });
          }

          localStorage.setItem(migrationKey, "true");
          localStorage.setItem(legacyOwnerKey, String(userId));
          console.log(`[System] 已将旧版本地数据迁移到用户 ${userId} 的独立数据库。`);
        }

        // 动态初始化数据库函数
        async function initDatabase(userId) {
          db = new Dexie(getProjectDatabaseName(userId));
          db.version(66).stores({
            // 版本号从 51 升级到 52
            chats:
              "&id, isGroup, groupId, ownerId, isPinned, characterPhoneData, latestInnerVoice, innerVoiceHistory, loversSpaceData.emotionDiaries, settings.summary, settings.weiboNickname, settings.innerVoiceHideHeaderBorder, settings.innerVoiceAdopterLabelFormat, interactionStats, unlockedSymbols, settings.selectedIntimacyBadge",
            apiConfig: "&id",
            globalSettings: "&id, activeThemeId",
            userStickers: "&id, url, name, categoryId",
            userStickerCategories: "++id, &name",
            charStickers: "&id, url, name",
            worldBooks: "&id, name, categoryId",
            worldBookCategories: "++id, name",
            musicLibrary: "&id",
            personaPresets: "&id",
            qzoneSettings: "&id",
            qzonePosts: "++id, authorId, timestamp",
            qzoneAlbums: "++id, name, createdAt",
            qzonePhotos: "++id, albumId",
            favorites: "++id, type, timestamp, originalTimestamp",
            qzoneGroups: "++id, name",
            memories: "++id, chatId, timestamp, type, targetDate",
            callRecords: "++id, chatId, timestamp, customName",
            customAvatarFrames: "&id, name, url",
            themes: "++id, name, css",
            apiPresets: "++id, name, proxyUrl",
            bubbleStylePresets: "++id, name, css",
            fontPresets: "&id, name, url",
            homeScreenPresets: "++id, name",
            weiboPosts: "++id, authorId, timestamp",
            forumGroups: "++id, name, worldview, *categories",
            forumPosts:
              "++id, groupId, timestamp, *categories, seriesId, lengthType, chapterIndex",
            forumComments: "++id, postId, timestamp",
            forumCategories: "++id, name",
            forumSeries:
              "++id, groupId, isFollowed, updatedAt, bookshelfAddedAt",
            forumChapters: "++id, seriesId, chapterIndex, createdAt, postId",
            tarotReadings: "++id, timestamp",
            pomodoroSessions: "++id, chatId, startTime",
            scriptKillScripts: "++id, name, isBuiltIn",
            taobaoProducts: "++id, name, category",
            taobaoOrders: "++id, productId, timestamp",
            taobaoCart: "++id, productId",
            userWalletTransactions: "++id, timestamp",
            charPhonePresets: "++id, name",
            ludoQuestionBanks: "++id, name",
            ludoQuestions: "++id, bankId, text, type",
            datingScenes: "&uid, imageUrl",
            datingPresets: "++id, name, settings.spriteGroupId",
            datingSpriteGroups: "++id, name",
            datingSprites: "++id, groupId, description, url",
            datingHistory: "++id, characterId, timestamp",
            offlinePresets: "++id, name",
            elemeFoods: "++id, name, category",
            elemeOrders: "++id, recipientId, timestamp",
            studioScripts: "++id, name",
            studioHistory: "++id, timestamp",
            studioSessions: "&id, status, updatedAt, scriptId, aiChatId",
            studioMemories: "&id, aiChatId, createdAt, sessionId",
            tukeyAccounts: "++id, category, type", // 这是你已有的，保持不变
            tukeyAccountingGroups: "&id", // 记账群聊设置 (id, name, members, replySettings)
            tukeyAccountingRecords:
              "++id, groupId, timestamp, isRepliedTo, accountId",
            tukeyAccountingReplies: "++id, recordId, charId", // AI的回复记录
            tukeyUserSettings: "&id",
            tukeyCustomConfig: "&id",
            auroraBooks: "++id, title, content, addedAt",
            passerbyAvatars: "++id, url",
            clawMachineDolls: "++id, url",
            mcpConnections: "&id, type, enabled, status, updatedAt",
            mcpSecrets: "&id, updatedAt",
            mcpCapabilities: "&id, connectionId, kind, name, updatedAt",
            mcpActivities: "&id, connectionId, chatId, status, createdAt",
            mcpSubscriptions: "&id, connectionId, uri, updatedAt",
            mcpTasks: "&id, connectionId, status, updatedAt",
            mcpApprovals: "&id, connectionId, toolName, scope, updatedAt",
            mcpSettings: "&id",
            memorySettings: "&id, chatId, updatedAt",
            memoryVectors: "&id, chatId, sourceType, timestamp, provider, contentHash",
            memoryFacts: "&id, chatId, status, category, updatedAt, [chatId+status]",
            memoryRecallLogs: "&id, chatId, timestamp, mode",
            promptSettings: "&id, updatedAt",
            promptItems: "&id, featureId, kind, updatedAt",
            promptPresets: "&id, name, updatedAt",
            promptBindings: "&id, scopeType, scopeId, featureId",
            promptDiagnostics: "++id, timestamp, featureId",
          });
          window.db = db;
          await db.open();
          // 不再自动读取通用的 GeminiChatDB。该数据库可能属于同源运行的
          // xinyuan330 或其他项目；世界书等旧数据只能由用户在诊断工具中
          // 主动选择并确认后，以只读副本的方式导入。
          console.log(`[System] 已加载用户 ${userId} 的独立数据库`);
        }
        // === 修改结束 ===

        // ===================================================================
        // 3. 所有功能函数定义
        // ===================================================================

        /**
         * 切换语音消息的文字显示/隐藏
         * @param {HTMLElement} bubble - 被点击的语音消息的 .message-bubble 元素
         */
        function toggleVoiceTranscript(bubble) {
          if (!bubble) return;

          const transcriptEl = bubble.querySelector(".voice-transcript");
          if (!transcriptEl) return;

          // 核心逻辑：直接检查文字区域当前是不是显示状态
          const isCurrentlyExpanded = transcriptEl.style.display === "block";

          if (isCurrentlyExpanded) {
            // 如果是展开的，就直接收起来
            transcriptEl.style.display = "none";
          } else {
            // 如果是收起的，就执行展开流程

            // 1. 先显示一个“正在转写”的提示，给用户即时反馈
            transcriptEl.textContent = "正在转文字...";
            transcriptEl.style.display = "block";

            // 2. 模拟一个短暂的“识别”过程
            setTimeout(() => {
              // 再次检查元素是否还在页面上，防止用户切换聊天导致错误
              if (document.body.contains(transcriptEl)) {
                // 获取并显示真正的转写文字
                const voiceText = bubble.dataset.voiceText || "(无法识别)";
                transcriptEl.textContent = voiceText;
              }
            }, 300); // 300毫秒的延迟，感觉更灵敏
          }
        }

        /**
         * 【V2智能版】应用指定的主题，并智能刷新当前打开的任何界面
         * @param {string} theme - 'light' 或 'dark'
         */
        function applyTheme(theme) {
          const phoneScreen = document.getElementById("phone-screen");
          const toggleSwitch = document.getElementById("theme-toggle-switch");

          const isDark = theme === "dark";

          // 核心操作：为手机屏幕添加或移除 .dark-mode 类
          phoneScreen.classList.toggle("dark-mode", isDark);

          // 同步开关的状态
          if (toggleSwitch) {
            toggleSwitch.checked = isDark;
          }

          // 保存用户的选择
          projectStorage.setItem("ephone-theme", theme);

          // 不再只关心聊天界面，而是找出当前究竟是哪个界面处于激活状态
          const activeScreen = document.querySelector(".screen.active");
          if (!activeScreen) return; // 如果找不到，就退出

          // 根据当前激活的界面ID，调用它专属的刷新函数
          switch (activeScreen.id) {
            case "chat-interface-screen":
              if (state.activeChatId) {
                renderChatInterface(state.activeChatId);
              }
              break;
            case "wallpaper-screen":
              // 外观设置页也需要重新渲染来应用新主题
              renderWallpaperScreen();
              break;
            case "font-settings-screen":
              // 字体预设页同样需要
              renderFontPresets();
              break;
            // 如果未来还有其他页面需要适配，在这里添加 case 即可
          }
        }

        /**
         * 当用户点击开关时，切换当前的主题
         */
        function toggleTheme() {
          const toggleSwitch = document.getElementById("theme-toggle-switch");
          // 直接根据开关的选中状态来决定新主题
          const newTheme = toggleSwitch.checked ? "dark" : "light";
          applyTheme(newTheme);
        }
        const fontPresetFaces = new Map();
        let fontPreviewObserver = null;

        function getSortedFontPresets(presets) {
          return [...(presets || [])].sort((a, b) => {
            const orderA = Number.isFinite(a.sortOrder) ? a.sortOrder : Infinity;
            const orderB = Number.isFinite(b.sortOrder) ? b.sortOrder : Infinity;
            return orderA - orderB || (a.createdAt || 0) - (b.createdAt || 0) ||
              String(a.id).localeCompare(String(b.id));
          });
        }

        function inferFontSourceType(url) {
          return String(url || "").startsWith("data:") ? "local" : "url";
        }

        function inferFontFormat(value) {
          const source = String(value || "").toLowerCase().split(/[?#]/)[0];
          const match = source.match(/\.(woff2|woff|ttf|otf)$/);
          return match ? match[1].toUpperCase() : "字体文件";
        }

        function formatFontSize(bytes) {
          if (!Number.isFinite(bytes) || bytes <= 0) return "大小未知";
          if (bytes < 1024 * 1024) return `${Math.max(1, Math.round(bytes / 1024))} KB`;
          return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
        }

        function escapeFontMarkup(value) {
          return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#39;");
        }

        function getFontFamilyName(id) {
          const value = String(id);
          let hash = 2166136261;
          for (let index = 0; index < value.length; index += 1) {
            hash ^= value.charCodeAt(index);
            hash = Math.imul(hash, 16777619);
          }
          return `user-font-${(hash >>> 0).toString(36)}`;
        }

        async function loadFontFace(preset, forceReload = false) {
          if (!preset?.url) throw new Error("字体来源为空");
          const key = String(preset.id);
          if (!forceReload && fontPresetFaces.has(key)) {
            return fontPresetFaces.get(key);
          }
          const family = getFontFamilyName(key);
          const face = new FontFace(family, `url(${JSON.stringify(preset.url)})`);
          const timeout = new Promise((_, reject) =>
            setTimeout(() => reject(new Error("字体加载超时，请检查链接或网络")), 15000),
          );
          const loadedFace = await Promise.race([face.load(), timeout]);
          document.fonts.add(loadedFace);
          const result = { face: loadedFace, family };
          fontPresetFaces.set(key, result);
          return result;
        }

        async function migrateFontPresetMetadata() {
          const presets = await db.fontPresets.toArray();
          const sorted = getSortedFontPresets(presets);
          const updates = [];
          sorted.forEach((preset, index) => {
            const migrated = { ...preset };
            let changed = false;
            if (!Number.isFinite(migrated.sortOrder)) {
              migrated.sortOrder = index;
              changed = true;
            }
            if (!migrated.sourceType) {
              migrated.sourceType = inferFontSourceType(migrated.url);
              changed = true;
            }
            if (!migrated.format) {
              migrated.format = inferFontFormat(migrated.url);
              changed = true;
            }
            if (!migrated.createdAt) {
              const timestamp = Number(String(migrated.id).match(/\d+/)?.[0]);
              migrated.createdAt = Number.isFinite(timestamp) ? timestamp : Date.now() + index;
              changed = true;
            }
            if (changed) updates.push(migrated);
          });
          if (updates.length) await db.fontPresets.bulkPut(updates);
        }

        async function loadAllFontPresetsOnStartup() {
          await migrateFontPresetMetadata();
          let activeId = state.globalSettings?.fontPresetId;
          const presets = await db.fontPresets.toArray();
          const storedActive = activeId ? await db.fontPresets.get(activeId) : null;
          if (!storedActive && state.globalSettings?.fontUrl) {
            const matched = presets.find((preset) => preset.url === state.globalSettings.fontUrl);
            if (matched) {
              activeId = matched.id;
              state.globalSettings.fontPresetId = matched.id;
              await db.globalSettings.put(state.globalSettings);
            }
          }
          if (activeId) {
            const activePreset = await db.fontPresets.get(activeId);
            if (activePreset) await loadFontFace(activePreset).catch(() => null);
          }
        }

        function createFontButton(label, className, presetId, handler, disabled = false) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = `preset-btn ${className}`.trim();
          button.textContent = label;
          button.dataset.presetId = String(presetId);
          button.disabled = disabled;
          button.onclick = handler;
          return button;
        }

        async function renderFontPresets() {
          const container = document.getElementById("font-preset-container");
          if (!container) return;
          const allPresets = getSortedFontPresets(await db.fontPresets.toArray());
          const searchInput = document.getElementById("font-library-search");
          const query = String(searchInput?.value || "").trim().toLocaleLowerCase();
          const presets = query
            ? allPresets.filter((preset) => String(preset.name || "").toLocaleLowerCase().includes(query))
            : allPresets;
          container.replaceChildren();

          const count = document.getElementById("font-library-count");
          const localBytes = allPresets.reduce((sum, preset) => sum + (Number(preset.size) || 0), 0);
          if (count) {
            const totalLabel = localBytes > 0
              ? `${allPresets.length} 个 · ${formatFontSize(localBytes)}`
              : `${allPresets.length} 个字体`;
            count.textContent = query ? `${presets.length}/${totalLabel}` : totalLabel;
          }

          const activeId = state.globalSettings?.fontPresetId;
          const activePreset = activeId
            ? allPresets.find((preset) => String(preset.id) === String(activeId))
            : null;
          const compatibleActivePreset = activePreset ||
            allPresets.find((preset) => preset.url === state.globalSettings?.fontUrl);
          const hasCompatibleCustomFont = !compatibleActivePreset && Boolean(state.globalSettings?.fontUrl);
          const currentName = document.getElementById("font-current-name");
          const currentStatus = document.getElementById("font-current-status");
          if (currentName) currentName.textContent = compatibleActivePreset?.name ||
            (hasCompatibleCustomFont ? "自定义字体" : "默认字体");
          if (currentStatus) currentStatus.textContent = compatibleActivePreset
            ? `${compatibleActivePreset.sourceType === "local" ? "本地字体" : "URL 字体"} · 已应用到全局`
            : hasCompatibleCustomFont ? "旧配置兼容模式 · 已应用到全局" : "使用应用默认字体";

          if (!presets.length) {
            const empty = document.createElement("div");
            empty.className = "font-preset-slot empty";
            empty.textContent = query
              ? "没有匹配的字体，请更换关键词"
              : "字体库为空，可通过 URL 或本地文件添加";
            container.appendChild(empty);
          }

          presets.forEach((preset, index) => {
            const actualIndex = allPresets.findIndex((item) => String(item.id) === String(preset.id));
            const slot = document.createElement("article");
            slot.className = "font-preset-slot";

            const preview = document.createElement("div");
            preview.className = "font-preview-text";
            preview.dataset.presetId = String(preset.id);
            preview.textContent = "你好 Hello 123 · 字体预览";

            const info = document.createElement("div");
            info.className = "font-preset-info";
            const nameRow = document.createElement("div");
            nameRow.className = "font-preset-name-row";
            const name = document.createElement("span");
            name.className = "font-preset-name";
            name.textContent = preset.name || "未命名字体";
            name.title = name.textContent;
            nameRow.appendChild(name);
            if (compatibleActivePreset && String(compatibleActivePreset.id) === String(preset.id)) {
              const badge = document.createElement("span");
              badge.className = "font-preset-badge";
              badge.textContent = "使用中";
              nameRow.appendChild(badge);
            }
            const meta = document.createElement("small");
            meta.className = "font-preset-meta";
            meta.textContent = `${preset.sourceType === "local" ? "本地" : "URL"} · ${preset.format || inferFontFormat(preset.url)} · ${formatFontSize(preset.size)}`;
            info.append(nameRow, meta);

            const actions = document.createElement("div");
            actions.className = "font-preset-actions";
            actions.append(
              createFontButton("应用", "apply-btn", preset.id, () => applyFontPreset(preset.id), Boolean(compatibleActivePreset && String(compatibleActivePreset.id) === String(preset.id))),
              createFontButton("重命名", "secondary rename-btn", preset.id, () => renameFontPreset(preset.id)),
              createFontButton("上移", "secondary move-up-btn", preset.id, () => moveFontPreset(preset.id, -1), actualIndex === 0 || Boolean(query)),
              createFontButton("下移", "secondary move-down-btn", preset.id, () => moveFontPreset(preset.id, 1), actualIndex === allPresets.length - 1 || Boolean(query)),
              createFontButton("删除", "delete delete-btn", preset.id, () => deleteFontPreset(preset.id)),
            );
            slot.append(preview, info, actions);
            container.appendChild(slot);
          });

          if (fontPreviewObserver) fontPreviewObserver.disconnect();
          if ("IntersectionObserver" in window) {
            fontPreviewObserver = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const preset = allPresets.find((item) => String(item.id) === entry.target.dataset.presetId);
                if (preset) loadFontForPreview(preset);
                fontPreviewObserver.unobserve(entry.target);
              });
            }, { root: document.getElementById("font-settings-screen"), rootMargin: "120px" });
            container.querySelectorAll(".font-preview-text").forEach((element) => fontPreviewObserver.observe(element));
          } else {
            presets.forEach(loadFontForPreview);
          }

          addFontPresetButtonListeners();
        }

        async function loadFontForPreview(preset) {
          const preview = [...document.querySelectorAll(".font-preview-text")]
            .find((element) => element.dataset.presetId === String(preset.id));
          if (!preview) return;
          preview.dataset.loadState = "loading";
          try {
            const { family } = await loadFontFace(preset);
            preview.style.fontFamily = `'${family}', 'bulangni', sans-serif`;
            preview.dataset.loadState = "loaded";
          } catch (error) {
            preview.dataset.loadState = "failed";
            preview.title = `加载失败：${error.message}`;
            preview.textContent = "字体加载失败，可删除后重新添加";
          }
        }

        function addFontPresetButtonListeners() {
          const urlButton = document.getElementById("add-font-url-btn");
          const localButton = document.getElementById("add-font-local-btn");
          const searchInput = document.getElementById("font-library-search");
          const previewInput = document.getElementById("font-preview-input");
          if (urlButton) urlButton.onclick = handleUploadFontUrl;
          if (localButton) localButton.onclick = handleUploadFontLocal;
          if (searchInput) searchInput.oninput = renderFontPresets;
          if (previewInput) previewInput.oninput = () => {
            const heading = document.querySelector("#font-preview .font-preview-heading");
            if (heading) heading.textContent = previewInput.value.trim() || "你好世界 Hello World 12345";
          };
        }

        async function handleUploadFontUrl() {
          const value = await showCustomPrompt("字体URL", "请输入字体文件的 HTTPS 或 HTTP 直链");
          if (value === null) return;
          let parsedUrl;
          try {
            parsedUrl = new URL(value.trim());
            if (!/^https?:$/.test(parsedUrl.protocol)) throw new Error("protocol");
          } catch (_) {
            await showCustomAlert("无法添加字体", "请输入有效的 HTTP 或 HTTPS 字体链接。");
            return;
          }
          const name = await showCustomPrompt("字体命名", "请为这个字体起个名字");
          if (!name?.trim()) {
            if (name !== null) await showCustomAlert("无法添加字体", "字体名称不能为空。");
            return;
          }
          await saveFontPreset(name.trim(), parsedUrl.href, {
            sourceType: "url",
            format: inferFontFormat(parsedUrl.pathname),
          });
        }

        function detectLocalFontFormat(buffer) {
          const bytes = new Uint8Array(buffer.slice(0, 4));
          const ascii = String.fromCharCode(...bytes);
          if (ascii === "wOF2") return "WOFF2";
          if (ascii === "wOFF") return "WOFF";
          if (ascii === "OTTO") return "OTF";
          if (bytes[0] === 0 && bytes[1] === 1 && bytes[2] === 0 && bytes[3] === 0) return "TTF";
          return "";
        }

        function readFileAsDataUrl(file) {
          return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(reader.result);
            reader.onerror = () => reject(reader.error || new Error("无法读取字体文件"));
            reader.readAsDataURL(file);
          });
        }

        function handleUploadFontLocal() {
          const input = document.getElementById("font-preset-local-upload");
          input.value = "";
          input.onchange = async (event) => {
            const file = event.target.files?.[0];
            if (!file) return;
            try {
              const header = await file.slice(0, 4).arrayBuffer();
              const format = detectLocalFontFormat(header);
              if (!format) {
                await showCustomAlert(
                  "无法添加字体",
                  "无法识别这个字体文件，请选择有效的 WOFF2、WOFF、TTF 或 OTF 文件。",
                );
                return;
              }
              if (file.size > 12 * 1024 * 1024) {
                const confirmed = await showCustomConfirm(
                  "字体文件较大",
                  `这个字体约 ${formatFontSize(file.size)}，保存和加载时可能较慢。是否继续？`,
                );
                if (!confirmed) return;
              }
              const name = await showCustomPrompt(
                "字体命名",
                "请为这个字体起个名字",
                escapeFontMarkup(file.name.replace(/\.[^/.]+$/, "")),
              );
              if (!name?.trim()) {
                if (name !== null) await showCustomAlert("无法添加字体", "字体名称不能为空。");
                return;
              }
              const dataUrl = await readFileAsDataUrl(file);
              await saveFontPreset(name.trim(), dataUrl, {
                sourceType: "local",
                format,
                size: file.size,
              });
            } catch (error) {
              console.error("读取本地字体失败:", error);
              await showCustomAlert("读取字体失败", escapeFontMarkup(error.message));
            } finally {
              input.value = "";
            }
          };
          input.click();
        }

        async function saveFontPreset(name, url, metadata = {}) {
          const now = Date.now();
          const id = `font_${globalThis.crypto?.randomUUID?.() || `${now}_${Math.random().toString(36).slice(2)}`}`;
          const count = document.getElementById("font-library-count");
          if (count) count.textContent = "正在验证字体…";
          try {
            const presets = getSortedFontPresets(await db.fontPresets.toArray());
            const newPreset = {
              id,
              name,
              url,
              sourceType: metadata.sourceType || inferFontSourceType(url),
              format: metadata.format || inferFontFormat(url),
              size: metadata.size || 0,
              sortOrder: presets.length,
              createdAt: now,
              updatedAt: now,
            };
            await loadFontFace(newPreset, true);
            await db.fontPresets.put(newPreset);
            await renderFontPresets();
            await showCustomAlert("字体已添加", `“${escapeFontMarkup(name)}”已添加到字体库。`);
          } catch (error) {
            const loaded = fontPresetFaces.get(id);
            if (loaded?.face) document.fonts.delete(loaded.face);
            fontPresetFaces.delete(id);
            console.error("保存字体预设失败:", error);
            await showCustomAlert(
              "字体未保存",
              `${escapeFontMarkup(error.message)}。原有字体数据未受影响。`,
            );
            await renderFontPresets();
          }
        }

        async function renameFontPreset(presetId) {
          const preset = await db.fontPresets.get(presetId);
          if (!preset) return;
          const name = await showCustomPrompt(
            "重命名字体",
            "请输入新的字体名称",
            escapeFontMarkup(preset.name),
          );
          if (!name?.trim() || name.trim() === preset.name) return;
          await db.fontPresets.update(presetId, { name: name.trim(), updatedAt: Date.now() });
          await renderFontPresets();
        }

        async function moveFontPreset(presetId, direction) {
          const presets = getSortedFontPresets(await db.fontPresets.toArray());
          const index = presets.findIndex((preset) => String(preset.id) === String(presetId));
          const targetIndex = index + direction;
          if (index < 0 || targetIndex < 0 || targetIndex >= presets.length) return;
          [presets[index], presets[targetIndex]] = [presets[targetIndex], presets[index]];
          await db.fontPresets.bulkPut(presets.map((preset, order) => ({ ...preset, sortOrder: order })));
          await renderFontPresets();
        }

        /**
         * 删除一个字体预设
         * @param {string} presetId - 要删除的预设的ID
         */
        async function deleteFontPreset(presetId) {
          const preset = await db.fontPresets.get(presetId);
          if (!preset) return;
          const confirmed = await showCustomConfirm(
            "确认删除",
            "确定要删除这个字体吗？删除后无法从字体库恢复。",
            {
              confirmButtonClass: "btn-danger",
            },
          );
          if (confirmed) {
            const isActive = String(state.globalSettings?.fontPresetId || "") === String(presetId) ||
              (!state.globalSettings?.fontPresetId && state.globalSettings?.fontUrl === preset.url);
            if (isActive) await resetToDefaultFont(false);
            await db.fontPresets.delete(presetId);
            const loaded = fontPresetFaces.get(String(presetId));
            if (loaded?.face) document.fonts.delete(loaded.face);
            fontPresetFaces.delete(String(presetId));
            const remaining = getSortedFontPresets(await db.fontPresets.toArray());
            await db.fontPresets.bulkPut(remaining.map((item, order) => ({ ...item, sortOrder: order })));
            await renderFontPresets();
          }
        }

        /**
         * 应用一个字体预设为全局字体
         * @param {string} presetId - 要应用的预设的ID
         */
        async function applyFontPreset(presetId) {
          const preset = await db.fontPresets.get(presetId);
          if (preset) {
            const applyButton = [...document.querySelectorAll(".apply-btn")]
              .find((button) => button.dataset.presetId === String(presetId));
            if (applyButton) {
              applyButton.disabled = true;
              applyButton.textContent = "加载中";
            }
            try {
              await loadFontFace(preset);
              const applied = await applyCustomFont(preset.url, false, preset.id);
              if (!applied) throw new Error("字体无法应用");
              state.globalSettings.fontUrl = preset.url;
              state.globalSettings.fontPresetId = preset.id;
              await db.globalSettings.put(state.globalSettings);
              await renderFontPresets();
              await showCustomAlert(
                "字体已应用",
                `已将全局字体更换为“${escapeFontMarkup(preset.name)}”。`,
              );
            } catch (error) {
              console.error("应用字体失败:", error);
              await showCustomAlert(
                "字体应用失败",
                `${escapeFontMarkup(error.message)}。当前字体保持不变。`,
              );
              await renderFontPresets();
            }
          }
        }

        /**
         * 处理用户选择的角色卡文件
         * @param {File} file - 用户选择的文件对象
         */
        async function handleCharacterImport(file) {
          if (!file) return;

          try {
            let characterData;
            let avatarBase64;

            if (file.name.toLowerCase().endsWith(".png")) {
              // 如果是PNG文件，调用PNG解析函数
              const result = await parseCharPng(file);
              characterData = result.characterData;
              avatarBase64 = result.avatarBase64;
            } else if (file.name.toLowerCase().endsWith(".json")) {
              // 如果是JSON文件，调用JSON解析函数
              characterData = await parseCharJson(file);
              // JSON卡通常不包含图片，我们给一个默认头像
              avatarBase64 = defaultAvatar;
            } else {
              alert("不支持的文件格式，请选择 .png 或 .json 文件。");
              return;
            }

            if (characterData) {
              // 成功解析出数据后，调用创建函数
              await createCharacterFromData(characterData, avatarBase64);
            }
          } catch (error) {
            console.error("导入角色卡失败:", error);
            alert(`导入失败: ${error.message}`);
          }
        }

        /**
         * 解析SillyTavern的PNG角色卡，通过字节级操作彻底解决中文乱码问题。
         * @param {File} file - PNG文件
         * @returns {Promise<{characterData: object, avatarBase64: string}>}
         */
        async function parseCharPng(file) {
          return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = (e) => {
              const arrayBuffer = e.target.result;
              const dataView = new DataView(arrayBuffer);

              if (
                dataView.getUint32(0) !== 0x89504e47 ||
                dataView.getUint32(4) !== 0x0d0a1a0a
              ) {
                return reject(new Error("文件不是一个有效的PNG图片。"));
              }

              let offset = 8;
              let characterJson = null;

              while (offset < dataView.byteLength) {
                const length = dataView.getUint32(offset);
                const type = String.fromCharCode(
                  dataView.getUint8(offset + 4),
                  dataView.getUint8(offset + 5),
                  dataView.getUint8(offset + 6),
                  dataView.getUint8(offset + 7),
                );

                if (type === "tEXt") {
                  const chunkData = new Uint8Array(
                    arrayBuffer,
                    offset + 8,
                    length,
                  );

                  // 1. 先用一个简单的编码将字节转为字符串，以便查找关键字 "chara"
                  let text = "";
                  for (let i = 0; i < chunkData.length; i++) {
                    text += String.fromCharCode(chunkData[i]);
                  }

                  // 2. 检查关键字是否存在
                  const keyword = "chara" + String.fromCharCode(0);
                  if (text.startsWith(keyword)) {
                    // 3. 提取出关键字后面的 Base64 编码的字符串
                    const base64Data = text.substring(keyword.length);
                    try {
                      // 4. 使用 atob() 解码 Base64，得到一个“二进制字符串”
                      const binaryString = atob(base64Data);

                      // 5. 将这个“二进制字符串”重新转换为原始的 UTF-8 字节数组
                      const bytes = new Uint8Array(binaryString.length);
                      for (let i = 0; i < binaryString.length; i++) {
                        bytes[i] = binaryString.charCodeAt(i);
                      }

                      // 6. 使用 TextDecoder 将这个纯净的 UTF-8 字节数组解码为正确的字符串
                      const decodedJsonString = new TextDecoder("utf-8").decode(
                        bytes,
                      );

                      // 7. 解析最终的JSON字符串
                      characterJson = JSON.parse(decodedJsonString);
                      break;
                    } catch (e) {
                      return reject(
                        new Error(
                          "解析图片内嵌的角色数据失败，可能是数据损坏。",
                        ),
                      );
                    }
                  }
                }

                if (type === "IEND") break;
                offset += 12 + length;
              }

              if (characterJson) {
                const imageReader = new FileReader();
                imageReader.onload = (imgEvent) => {
                  resolve({
                    characterData: characterJson,
                    avatarBase64: imgEvent.target.result,
                  });
                };
                imageReader.onerror = () =>
                  reject(new Error("读取图片作为头像失败。"));
                imageReader.readAsDataURL(file);
              } else {
                reject(
                  new Error("在这张PNG图片中没有找到SillyTavern角色数据。"),
                );
              }
            };
            reader.onerror = () => reject(new Error("读取PNG文件失败。"));
            reader.readAsArrayBuffer(file);
          });
        }

        /**
         * 【修正版】解析JSON角色卡，强制使用UTF-8编码
         * @param {File} file - JSON文件
         * @returns {Promise<object>}
         */
        async function parseCharJson(file) {
          return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = (e) => {
              try {
                // 先读取为ArrayBuffer，再用TextDecoder指定UTF-8解码
                const arrayBuffer = e.target.result;
                const textDecoder = new TextDecoder("utf-8");
                const jsonString = textDecoder.decode(arrayBuffer);
                const data = JSON.parse(jsonString);
                // 兼容两种可能的格式
                resolve(data.data || data);
              } catch (error) {
                reject(new Error("解析JSON文件失败，请检查文件格式或编码。"));
              }
            };
            reader.onerror = () => reject(new Error("读取JSON文件失败。"));
            // 读取为ArrayBuffer而不是Text
            reader.readAsArrayBuffer(file);
          });
        }

        /**
         * 根据解析出的数据创建新角色和世界书。
         * 这个版本将优先查找您提供的 character_book 标准格式。
         * @param {object} data - 从卡片解析出的最原始的JSON数据
         * @param {string} avatarBase64 - 角色的头像图片 (Base64)
         */
        async function createCharacterFromData(data, avatarBase64) {
          // 步骤 1: 确定核心角色数据 (不变)
          const charData = data.data || data;
          const characterName = charData.name
            ? charData.name.trim()
            : "未命名角色";

          // 步骤 2: 创建新的聊天对象 (不变)
          const newChatId = "chat_" + Date.now();

          const newChat = {
            id: newChatId,
            name: characterName,
            isGroup: false,
            isPinned: false,
            history: [],
            unreadCount: 0,
            musicData: { totalTime: 0 },
            npcLibrary: [],
            relationship: {
              status: "friend",
              blockedTimestamp: null,
              applicationReason: "",
            },
            status: { text: "在线", lastUpdate: Date.now(), isBusy: false },
            weiboDms: [],
            loversSpaceData: null,
            settings: {
              aiPersona: charData.description || "该角色没有描述。",
              myPersona: "我是谁呀。",
              maxMemory: 10,
              aiAvatar: avatarBase64,
              myAvatar: defaultAvatar,
              background: "",
              theme: "default",
              fontSize: 13,
              customCss: "",
              linkedWorldBookIds: [],
              aiAvatarLibrary: [],
              stickerLibrary: [],
              summary: {
                enabled: false,
                mode: "auto",
                count: 20,
                prompt:
                  "请你以第三人称的视角，客观、冷静、不带任何感情色彩地总结以下对话的核心事件和信息。禁止进行任何角色扮演或添加主观评论。",
                lastSummaryIndex: -1,
              },
              linkedMemories: [],
              offlineMode: {
                enabled: false,
                prompt: "",
                style: "",
                wordCount: 300,
                presets: [],
              },
              timePerceptionEnabled: true,
              customTime: "",
              timeContext: {
                enabled: true,
                source: "device",
                timeZone:
                  window.TukTimeContext?.getDeviceTimeZone() || "UTC",
                customTime: "",
                gapAwareness: "precise",
                customPrompt: "",
              },
              isCoupleAvatar: false,
              coupleAvatarDescription: "",
              weiboProfession: "",
              weiboInstruction: "",
              singleChatFeatures: {
                innerVoice: false,
                qzone: false,
                weibo: false,
                forum: false,
                loversSpace: false,
              },
              visualVideoCallEnabled: false,
              charVideoImage: "",
              userVideoImage: "",
              videoCallVoiceAccess: false,
              petAdopted: false,
              pet: null,
            },
            characterPhoneData: {
              lastGenerated: null,
              chats: {},
              shoppingCart: [],
              memos: [],
              browserHistory: [],
              photoAlbum: [],
              bank: { balance: 0, transactions: [] },
              trajectory: [],
              appUsage: [],
              diary: [],
            },
          };

          await db.chats.put(newChat);
          state.chats[newChatId] = newChat;

          // 重构世界书查找逻辑
          console.log("开始检测世界书数据...");
          let worldBookFound = false;

          // 策略一：【最高优先级】查找提供的 character_book 标准格式
          if (
            charData.character_book &&
            charData.character_book.entries &&
            Array.isArray(charData.character_book.entries) &&
            charData.character_book.entries.length > 0
          ) {
            console.log(
              `检测到最新的 character_book 格式 (${charData.character_book.entries.length}条)，开始导入...`,
            );
            const newCategory = { name: characterName };
            const newCategoryId = await db.worldBookCategories.add(newCategory);

            await saveWorldBookEntriesFromArray(
              charData.character_book.entries,
              newCategoryId,
            );
            worldBookFound = true;
          }

          // 策略二：兼容旧的 world_entries 格式
          else if (
            charData.world_entries &&
            Array.isArray(charData.world_entries) &&
            charData.world_entries.length > 0
          ) {
            console.log(
              `检测到旧版 world_entries 格式 (${charData.world_entries.length}条)，开始导入...`,
            );
            const newCategory = { name: characterName };
            const newCategoryId = await db.worldBookCategories.add(newCategory);
            await saveWorldBookEntriesFromArray(
              charData.world_entries,
              newCategoryId,
            );
            worldBookFound = true;
          }

          // 策略三：兼容更旧的 data.world 格式
          else if (
            data.world &&
            typeof data.world === "string" &&
            data.world.trim()
          ) {
            console.log("检测到外层 world 字段格式，开始导入...");
            const newCategory = { name: characterName };
            const newCategoryId = await db.worldBookCategories.add(newCategory);
            await saveWorldBookEntriesFromArray(
              [{ name: characterName, content: data.world, constant: true }],
              newCategoryId,
            );
            worldBookFound = true;
          }

          // 策略四：最后的兼容手段 world_info
          else if (
            charData.world_info &&
            typeof charData.world_info === "string" &&
            charData.world_info.trim()
          ) {
            console.log("检测到旧版 world_info 字段格式，开始导入...");
            const newCategory = { name: characterName };
            const newCategoryId = await db.worldBookCategories.add(newCategory);
            await saveWorldBookEntriesFromArray(
              [
                {
                  name: characterName,
                  content: charData.world_info,
                  constant: true,
                },
              ],
              newCategoryId,
            );
            worldBookFound = true;
          }

          if (!worldBookFound) {
            console.log("诊断：在此角色卡中未找到任何可识别的世界书字段。");
          }

          // 步骤 4: 刷新UI (不变)
          await renderChatList();
          await showCustomAlert(
            "导入成功！",
            `角色“${characterName}”已成功创建！`,
          );
        }

        /**
         * 从SillyTavern的 world_entries 或 character_book.entries 数组直接创建世界书
         * @param {Array<object>} entriesArray - 包含世界书条目的数组
         * @param {number} categoryId - 这些世界书所属的分类ID
         */
        async function saveWorldBookEntriesFromArray(entriesArray, categoryId) {
          const validEntries = entriesArray.filter(
            (entry) => entry && typeof entry.content === "string" && entry.content.trim(),
          );
          if (validEntries.length > 0) {
            const category = await db.worldBookCategories.get(categoryId);
            const newBook = window.TukWorldBook.normalizeBook(
              {
                name: category?.name || "角色世界书",
                categoryId,
                content: validEntries,
                source: { type: "character-card", importedAt: Date.now() },
              },
              { source: "character-card" },
            );
            await db.worldBooks.add(newBook);
            // 确保 state.worldBooks 也被更新，以便UI能立即显示
            const allBooks = await db.worldBooks.toArray();
            state.worldBooks = allBooks.map((book) =>
              window.TukWorldBook.normalizeBook(book),
            );
            console.log(
              `成功导入 1 本世界书和 ${validEntries.length} 个词条到分类ID: ${categoryId}`,
            );
          }
        }

        function getEventCoords(e) {
          // 如果是触摸事件，就从 e.touches[0] 获取
          if (e.touches && e.touches[0]) {
            return { x: e.touches[0].pageX, y: e.touches[0].pageY };
          }
          // 否则，就是鼠标事件，直接从 e 获取
          return { x: e.pageX, y: e.pageY };
        }

        function showScreen(screenId) {
          if (
            !document
              .getElementById("logistics-screen")
              .classList.contains("active")
          ) {
            logisticsUpdateTimers.forEach((timerId) => clearTimeout(timerId));
            logisticsUpdateTimers = [];
          }

          if (screenId === "chat-list-screen") {
            renderChatList();
            switchToChatListView("messages-view");
          }
          if (screenId === "api-settings-screen") {
            renderApiSettings();
          }
          if (screenId === "wallpaper-screen") {
            renderWallpaperScreen();
          }
          if (screenId === "world-book-screen") {
            renderWorldBookScreen();
          }
          if (screenId === "mcp-screen") {
            window.McpApp?.open();
          }
          if (screenId === "thought-chain-screen") {
            window.ThoughtChainApp?.open();
          }
          if (screenId === "prompt-center-screen") {
            window.PromptCenterApp?.open();
          }

          document
            .querySelectorAll(".screen")
            .forEach((s) => s.classList.remove("active"));
          const screenToShow = document.getElementById(screenId);
          if (screenToShow) {
            screenToShow.classList.add("active");
          }

          if (screenId === "chat-interface-screen") {
            updateListenTogetherIcon(state.activeChatId);
          }

          if (screenId === "font-settings-screen") {
            document.getElementById("font-preview").style.fontFamily = "";
            applyCustomFont(
              state.globalSettings.fontUrl || "",
              true,
              state.globalSettings.fontPresetId || "active-preview",
            );
            renderFontPresets();
          }
        }
        window.showScreen = showScreen; // 确保 showScreen 自己也是全局的

        window.updateListenTogetherIconProxy = () => {};

        function switchToChatListView(viewId) {
          const chatListScreen = document.getElementById("chat-list-screen");
          const views = {
            "messages-view": document.getElementById("messages-view"),
            "qzone-screen": document.getElementById("qzone-screen"),
            "favorites-view": document.getElementById("favorites-view"),
            "memories-view": document.getElementById("memories-view"), // <-- 新增这一行
          };
          const mainHeader = document.getElementById("main-chat-list-header");
          const mainBottomNav = document.getElementById("chat-list-bottom-nav"); // 获取主导航栏

          if (isFavoritesSelectionMode) {
            document.getElementById("favorites-edit-btn").click();
          }

          // 隐藏所有视图
          Object.values(views).forEach((v) => v.classList.remove("active"));
          // 显示目标视图
          if (views[viewId]) {
            views[viewId].classList.add("active");
          }

          // 更新底部导航栏高亮
          document
            .querySelectorAll("#chat-list-bottom-nav .nav-item")
            .forEach((item) => {
              item.classList.toggle("active", item.dataset.view === viewId);
            });

